# ─── RailPredict environment variables ───────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is gitignored; this file is committed.
# All variables are read by the app via dotenvy at startup.

# ─── Database ─────────────────────────────────────────────────────────────────
# Connection string for the PostgreSQL instance.
# When using docker compose, the hostname is "db" (the service name).
# For local development without Docker: use "localhost".
DATABASE_URL=postgres://railpredict:railpredict@db:5432/railpredict

# Password for the postgres "railpredict" user.
# Must match POSTGRES_PASSWORD in the db service and the DATABASE_URL above.
DB_PASSWORD=railpredict

# ─── GBR Retail API ───────────────────────────────────────────────────────────
# Required. API key for the GBR / RTT Retail API (x-apikey header).
# Apply at https://www.realtimetrains.co.uk/about/developer/pull/
GBR_API_KEY=

# Optional. Override the base URL (useful for pointing at a test stub).
# GBR_API_BASE_URL=https://api.rtt.io/api

# ─── Darwin Push Port (STOMP) ─────────────────────────────────────────────────
# Required. Credentials from the Network Rail Open Data portal:
# https://opendata.nationalrail.co.uk/
DARWIN_HOST=
DARWIN_PORT=61613
DARWIN_USERNAME=
DARWIN_PASSWORD=

# Optional. Override the STOMP subscription topic.
# DARWIN_DESTINATION=/topic/darwin.pushport-v16

# ─── Ingestion filter ─────────────────────────────────────────────────────────
# Optional. Comma-separated CRS codes to watch. Empty = watch all UK trains.
# Example for Yorkshire only:
# WATCHED_ROUTES=LDS,HUL,YRK,HGT,SKI,BFD,WKF
WATCHED_ROUTES=

# ─── Static data ingest ───────────────────────────────────────────────────────
# URL of the GTFS feed to download when running `railpredict ingest-static`.
# Network Rail GTFS: check https://opendata.nationalrail.co.uk/ for current URL.
GTFS_URL=

# ─── Observability ────────────────────────────────────────────────────────────
# Log level: trace | debug | info | warn | error
LOG_LEVEL=info

# Log format: pretty (human-readable) | json (for log aggregators)
LOG_FORMAT=pretty

# ─── API server ───────────────────────────────────────────────────────────────
# Address and port the axum server binds to.
API_BIND_ADDR=0.0.0.0:3000

# ─── pgAdmin (dev only, docker compose --profile dev up) ──────────────────────
PGADMIN_EMAIL=admin@railpredict.local
PGADMIN_PASSWORD=admin
