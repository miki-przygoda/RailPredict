# ── Required ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Must point at a running Postgres instance with
# the RailPredict schema applied (migrations run automatically at startup).
DATABASE_URL=postgresql://railpredict:railpredict@localhost:5432/railpredict

# ── Darwin Push Port (optional — live ingestion) ───────────────────────────────
# Credentials for the National Rail Darwin Push Port STOMP feed.
# Register at https://datafeeds.networkrail.co.uk/
# Without these, the server starts but receives no live train updates.
DARWIN_HOST=
DARWIN_USERNAME=
DARWIN_PASSWORD=
# Default topic — only change if National Rail updates the push port version.
# DARWIN_DESTINATION=/topic/darwin.pushport-v16

# ── GBR Retail API (optional — live purchase flow) ────────────────────────────
# API key for the Great British Railways Retail API.
# Required only for Tier C (live seat availability + ticket purchase).
# Without it, the server runs in Tier A/B only mode.
GBR_API_KEY=
# GBR_API_BASE_URL=https://api.rtt.io/api

# ── Application ───────────────────────────────────────────────────────────────
# Comma-separated CRS codes to watch (e.g. KGX,MAN,LDS).
# Trains not passing through a watched station are dropped at ingestion.
WATCHED_ROUTES=KGX,MAN,LDS,EUS,PAD,BHM,BRI,NCL,EDI,GLC

# Log level: error | warn | info | debug | trace  (default: info)
# LOG_LEVEL=info

# Log format: pretty | json  (default: pretty; use json in production)
# LOG_FORMAT=pretty

# Bind address for the HTTP server (default: 0.0.0.0:3000)
# API_BIND_ADDR=0.0.0.0:3000

# Allowed CORS origins — comma-separated. Required in production; omit in dev.
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Per-IP HTTP rate limit in requests/second (default: 60)
# HTTP_RATE_LIMIT_PER_SEC=60

# Max Postgres connections in the pool (default: 10)
# DB_MAX_CONNECTIONS=10

# ── Push notifications (optional) ─────────────────────────────────────────────
# ntfy.sh topic URL. If set, a notification fires whenever a train enters
# Critical state. Leave blank to disable.
# NTFY_URL=https://ntfy.sh/your-topic

# ── Weather volatility (optional) ─────────────────────────────────────────────
# Comma-separated lat,lon pairs for weather polling anchors (Open-Meteo).
# Trains on routes near these anchors are promoted when wind exceeds threshold.
# Format: "lat:lon:label,lat:lon:label"  e.g. "51.5074:-0.1278:London"
# WEATHER_ANCHORS=51.5074:-0.1278:London,53.4808:-2.2426:Manchester

# ── HSP historical fetch (scripts/fetch_hsp_history.py only) ──────────────────
# National Rail Data Portal credentials for the Historic Service Performance API.
# Register at https://opendata.nationalrail.co.uk/ and tick HSP under Subscriptions.
# These are separate from the Darwin STOMP credentials above.
HSP_USERNAME=
HSP_PASSWORD=
